# Copy to .env and replace every password/key before first launch.
APP_NAME=QBot AI 多账号智能 QQ 机器人管理平台
ENV=production
DEBUG=false
PUBLIC_BASE_URL=https://your-domain.example

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Initial account only; change the password immediately after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_EMAIL=admin@example.com

# Bind to loopback by default. Put TLS termination and IP allow-list in front of Nginx.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=qbot
POSTGRES_USER=qbot
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# 单个账号同时在途的 AI 请求上限。AI 回复在后台任务中执行，不阻塞消息事件流；
# 不同群/私聊之间可并发，同一会话仍按顺序处理。上游限流严格时调小到 2。
AI_MAX_CONCURRENCY=4

GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN=
GITHUB_POLL_DEFAULT_SECONDS=900
PUSH_MAX_RETRIES=3
# 在线版本检查源（GitHub Releases）；Web 项目提示新版本，不在浏览器内自动替换服务端文件。
UPDATE_REPOSITORY=yuchen0x1/AI-QQ-Bot
UPDATE_CHANNEL=stable
UPDATE_CHECK_INTERVAL_MINUTES=360
# 告警 Webhook 默认拒绝私有/回环/链路本地 IP，只有隔离部署确有需要时才开启。
# ALERT_ALLOW_PRIVATE_NETWORKS=false

# GitHub Token 连接：直接在「GitHub 仓库监控」页填写专用 Token，无需 OAuth App。
# 全部仓库动态通知、通知群绑定与实时 Webhook 见 docs/GITHUB_NOTIFICATIONS.md。
# GitHub OAuth（可选）：让网页用户绑定自己的 GitHub 账号并一键导入仓库。
# 也可以登录后台在「GitHub 仓库监控 → 配置 OAuth App」里填写，数据库配置优先于这里。
# 在 GitHub → Settings → Developer settings → OAuth Apps 创建应用，
# Authorization callback URL 必须是 PUBLIC_BASE_URL + /api/github/oauth/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPES=read:user repo
# 反向代理或本地开发（前端 5173）时可显式指定完整回调地址
# GITHUB_OAUTH_REDIRECT_URI=https://your-domain.example/api/github/oauth/callback

ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=240
CORS_ORIGINS=https://your-domain.example

# QQ 官方机器人（默认接入方式）的 AppID / AppSecret 在后台「QQ 账号管理 → 添加机器人」
# 中填写并加密存入数据库，不要写进 .env。仅需在网络代理等特殊环境覆盖平台域名：
# QQBOT_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
# QQBOT_OPENAPI_BASE=https://api.bot.qq.com
# QQBOT_SANDBOX_OPENAPI_BASE=https://sandbox.api.sgroup.qq.com
# Webhook 事件推送允许的时间戳偏差（秒），0 表示只验签名不校验新鲜度
# QQBOT_WEBHOOK_MAX_AGE_SECONDS=300

# Optional only when using standalone backend / local development.
# DATABASE_URL=postgresql+asyncpg://qbot:password@127.0.0.1:5432/qbot
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_ENABLED=true
# REDIS_QUEUE_ENABLED=true
# REDIS_QUEUE_NAME=qbot:tasks
# INSTANCE_ID=backend-1
# ACCOUNT_LEASE_SECONDS=45
# ACCOUNT_LEASE_RENEW_SECONDS=15
# DATA_DIR=./data
# BACKUP_DIR=./backups
# PLUGIN_DIR=./backend/plugins
# Agent Mail native executable override; optional when installed on PATH or in the Docker image.
# AGENTLY_CLI_PATH=/usr/local/bin/agently-cli
