# Copy to .env and replace every password/key before first launch.
APP_NAME=QBot AI 多账号智能 QQ 机器人管理平台
ENV=production
DEBUG=false
PUBLIC_BASE_URL=https://your-domain.example

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Initial account only; change the password immediately after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Bind to loopback by default. Put TLS termination and IP allow-list in front of Nginx.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=qbot
POSTGRES_USER=qbot
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Shanghai
GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN=
GITHUB_POLL_DEFAULT_SECONDS=900
PUSH_MAX_RETRIES=3

ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=240
CORS_ORIGINS=https://your-domain.example

# Optional managed NapCat QR login. Keep WebUI inside the private Docker network;
# never publish port 6099 through the public Nginx entrypoint.
# For multiple instances use a JSON array in NAPCAT_INSTANCES_JSON, for example:
# [{"id":"qq-1","name":"机器人 1","webui_url":"http://napcat-1:6099","webui_token":"change-me","api_base":"http://napcat-1:3000","ws_url":"ws://napcat-1:3001","access_token":"onebot-secret"}]
NAPCAT_WEBUI_URL=http://napcat-1:6099
NAPCAT_WEBUI_TOKEN=replace-with-napcat-webui-token
NAPCAT_API_BASE=http://napcat-1:3000
NAPCAT_WS_URL=ws://napcat-1:3001
# OneBot access token used by QBot when calling NapCat HTTP/WS. Keep empty only if NapCat has no OneBot token.
NAPCAT_ACCESS_TOKEN=replace-with-onebot-access-token
NAPCAT_INSTANCES_JSON=

# Optional only when using standalone backend / local development.
# DATABASE_URL=postgresql+asyncpg://qbot:password@127.0.0.1:5432/qbot
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# REDIS_ENABLED=true
# DATA_DIR=./data
# BACKUP_DIR=./backups
# PLUGIN_DIR=./backend/plugins
