[Unit]
Description=QBot official QQ bot and repository notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qbot
Group=qbot
WorkingDirectory=/opt/qbot/current/backend
EnvironmentFile=/etc/qbot/qbot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/qbot/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qbot /var/backups/qbot

[Install]
WantedBy=multi-user.target
